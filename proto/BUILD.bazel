load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_utils_buf//:buf.bzl", "buf_format", "buf_generate", "buf_lint_test", "buf_module")

filegroup(
    name = "protos",
    srcs = glob(["**/*.proto"]),
    visibility = ["//visibility:public"],
)

# One module for every proto of the workspace, as `buf.yaml` lists them:
# buf refuses a listed module without files. Each template picks its own
# tree through `inputs`.
buf_module(
    name = "module",
    srcs = [
        ":protos",
        "//examples/glossary:protos",
        "//examples/refs:protos",
        "//rust/protocontract:protos",
    ],
    visibility = ["//visibility:public"],
)

buf_lint_test(
    name = "lint",
    size = "small",
    module = ":module",
)

buf_format(
    name = "format",
    module = ":module",
)

# buffa messages plus both protocontract-buffa layouts, from the plugin built here.
buf_generate(
    name = "golden",
    module = ":module",
    plugins = ["//rust/protoc-gen-protocontract-buffa"],
    template = "//:buf.gen.golden.yaml",
)

# `bazel run //proto:generate` refreshes the golden files;
# `bazel test //proto:all` fails while they differ from the plugin's output.
write_source_files(
    name = "generate",
    check_that_out_file_exists = False,
    files = {
        "//rust/golden:src/generated": ":golden",
    },
)
