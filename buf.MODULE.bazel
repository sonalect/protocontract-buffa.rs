"""Buf CLI and prebuilt protoc-gen plugins for the golden generate and proto lint."""

buf = use_extension("@bazel_utils_buf//:extensions.bzl", "buf")
buf.toolchains(version = "v1.74.0")
use_repo(buf, "buf")

# Root `protoc.plugin` tags are on PATH for every `buf_generate`. The plugin
# built from this tree is passed to `buf_generate` as a local target.
protoc = use_extension("@bazel_utils_protoc//:extensions.bzl", "protoc")
protoc.plugin(
    name = "protoc-gen-buffa",
    version = "v0.9.2",
)
protoc.plugin(
    name = "protoc-gen-buffa-packaging",
    version = "v0.9.2",
)
protoc.plugin(
    name = "protoc-gen-connect-rust",
    version = "v0.9.1",
)
protoc.plugin(
    name = "protoc-gen-protovalidate-buffa",
    version = "v0.10.4",
)
