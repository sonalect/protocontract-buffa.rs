load("@bazel_utils_rust//:rust.bzl", "cargo_audit_test")
load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")

# Every Rust target of the workspace, for clippy and rustfmt.
RUST_TARGETS = [
    "//examples/glossary/api",
    "//examples/glossary/app",
    "//examples/glossary/app:app_test",
    "//examples/glossary/consumer",
    "//examples/glossary/consumer:consumer_test",
    "//examples/glossary/provider",
    "//examples/glossary/provider:provider_test",
    "//examples/refs/api",
    "//examples/refs/api:api_no_tokio",
    "//examples/refs/api:refs_test",
    "//rust/protocontract",
    "//rust/protocontract:protocontract_no_tokio",
    "//rust/protocontract:protocontract_no_tokio_test",
    "//rust/protocontract:protocontract_test",
    "//rust/golden",
    "//rust/golden:golden_no_tokio",
    "//rust/golden:bridges_test",
    "//rust/golden:direct_test",
    "//rust/golden:streaming_test",
    "//rust/protoc-gen-protocontract-buffa",
    "//rust/protoc-gen-protocontract-buffa:lib",
    "//rust/protoc-gen-protocontract-buffa:lib_test",
]

rust_clippy_test(
    name = "lint",
    size = "small",
    targets = RUST_TARGETS,
)

# Their srcs include generated code (buffa, connect-rust, this plugin),
# which rustfmt would rewrite and which the generate checks guard instead.
GENERATED_SRCS = [
    "//examples/glossary/api",
    "//examples/refs/api",
    "//examples/refs/api:api_no_tokio",
    "//rust/golden",
    "//rust/golden:golden_no_tokio",
]

# `cargo fmt --check`, with the pinned toolchain's rustfmt.
rustfmt_test(
    name = "fmt",
    size = "small",
    targets = [t for t in RUST_TARGETS if t not in GENERATED_SRCS],
)

cargo_audit_test(
    name = "vuln",
    size = "small",
)
